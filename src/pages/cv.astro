---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const email = 'yousseflafdi00@gmail.com';
const telegram = 'https://t.me/yousseflafdi';
const github = 'https://github.com/youssef-lafdi';
---
<BaseLayout title="Lebenslauf | Youssef Lafdi" description="Vollständiger Lebenslauf von Youssef Lafdi — Bachelor Wirtschaftswissenschaften, Café-Manager, Freelance Web/Bot-Entwicklung, sucht Ausbildung zum Kaufmann für Digitalisierungsmanagement">
  <Header />
  <!-- Header -->
  <section class="relative overflow-hidden pt-20 pb-8 sm:pt-24">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="hero-glow"></div>
      <div class="grid-pattern absolute inset-0"></div>
    </div>

    <div class="relative z-10 mx-auto w-full max-w-5xl px-6">
      <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <a
          href="/"
          class="group inline-flex items-center gap-2 rounded-lg border border-slate-700 px-4 py-2 text-sm font-semibold text-slate-200 transition-colors duration-200 hover:border-emerald-500/50 hover:text-emerald-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950"
        >
          <span class="transition-transform duration-200 group-hover:-translate-x-0.5" aria-hidden="true">←</span>
          Zur Startseite
        </a>
        <a
          href="/cv/Youssef-Lafdi-CV.pdf"
          download
          class="group inline-flex items-center gap-2 rounded-lg bg-emerald-500 px-5 py-2 text-sm font-semibold text-slate-950 transition-colors duration-200 hover:bg-emerald-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950"
        >
          PDF herunterladen
          <span class="transition-transform duration-200 group-hover:translate-y-0.5" aria-hidden="true">↓</span>
        </a>
      </div>

      <h1 class="text-[clamp(2rem,6vw,4rem)] font-black leading-[0.95] tracking-tight text-slate-50">
        LEBENSLAUF
      </h1>
      <p class="mt-2 font-mono text-sm text-slate-400 sm:text-base">
        Youssef LAFDI — Ausbildung Kaufmann für Digitalisierungsmanagement · Bachelor Wirtschaftswissenschaften
      </p>
    </div>
  </section>

  <!-- CV Document -->
  <section class="mx-auto w-full max-w-5xl px-6 pb-12">
    <article class="rounded-2xl border border-slate-800/80 bg-slate-950/60 p-6 shadow-[0_25px_80px_-20px_rgba(2,6,23,0.8)] sm:p-10 lg:p-12">
      <!-- PERSÖNLICHE DATEN -->
      <section data-cv-section class="mb-10 sm:mb-12">
        <h2 class="text-xl font-bold tracking-tight text-slate-50 sm:text-2xl">
          PERSÖNLICHE DATEN
        </h2>
        <div class="mt-4 h-0.5 w-20 bg-emerald-500"></div>
        <dl class="mt-6 grid gap-x-8 gap-y-4 sm:grid-cols-2">
          <div class="flex flex-col gap-1 sm:flex-row sm:gap-4">
            <dt class="w-full shrink-0 font-mono text-xs uppercase tracking-wider text-emerald-500 sm:w-32">Name</dt>
            <dd class="text-slate-200">Youssef LAFDI</dd>
          </div>
          <div class="flex flex-col gap-1 sm:flex-row sm:gap-4">
            <dt class="w-full shrink-0 font-mono text-xs uppercase tracking-wider text-emerald-500 sm:w-32">Geburtsort</dt>
            <dd class="text-slate-200">M'Rirt, Marokko</dd>
          </div>
          <div class="flex flex-col gap-1 sm:flex-row sm:gap-4">
            <dt class="w-full shrink-0 font-mono text-xs uppercase tracking-wider text-emerald-500 sm:w-32">E-Mail</dt>
            <dd>
              <a href={`mailto:${email}`} class="text-emerald-400 hover:text-emerald-300 transition-colors">{email}</a>
            </dd>
          </div>
          <div class="flex flex-col gap-1 sm:flex-row sm:gap-4">
            <dt class="w-full shrink-0 font-mono text-xs uppercase tracking-wider text-emerald-500 sm:w-32">GitHub</dt>
            <dd>
              <a href={github} target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:text-emerald-300 transition-colors break-all">{github}</a>
            </dd>
          </div>
          <div class="flex flex-col gap-1 sm:flex-row sm:gap-4">
            <dt class="w-full shrink-0 font-mono text-xs uppercase tracking-wider text-emerald-500 sm:w-32">Telegram</dt>
            <dd>
              <a href={telegram} target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:text-emerald-300 transition-colors break-all">{telegram}</a>
            </dd>
          </div>
          <div class="flex flex-col gap-1 sm:flex-row sm:gap-4">
            <dt class="w-full shrink-0 font-mono text-xs uppercase tracking-wider text-emerald-500 sm:w-32">Standort</dt>
            <dd class="text-slate-200">M'Rirt, Marokko</dd>
          </div>
        </dl>
      </section>

      <!-- PROFIL -->
      <section data-cv-section class="mb-10 sm:mb-12">
        <h2 class="text-xl font-bold tracking-tight text-slate-50 sm:text-2xl">PROFIL</h2>
        <div class="mt-4 h-0.5 w-20 bg-emerald-500"></div>
        <p class="mt-6 leading-relaxed text-slate-300 sm:text-base">
          Bachelor in Wirtschaftswissenschaften &amp; Management (2024) mit über zwei Jahren praktischer Erfahrung im Café-Betrieb –
          vom Service bis zur Teamführung; davon über 1,5 Jahre als Manager. Parallel Freelance-Projekte in Web- und Bot-Entwicklung
          (Python, SQLite) sowie intensives Selbststudium von IT und KI. Deutsch auf B2-Niveau (telc-Vorbereitung läuft). Meine
          Bachelorarbeit über ChatGPT in Unternehmen weckte mein Interesse an digitalen Geschäftsprozessen. Deshalb suche ich eine
          Ausbildung zum Kaufmann für Digitalisierungsmanagement.
        </p>
      </section>

      <!-- AUSBILDUNG -->
      <section data-cv-section class="mb-10 sm:mb-12">
        <h2 class="text-xl font-bold tracking-tight text-slate-50 sm:text-2xl">AUSBILDUNG</h2>
        <div class="mt-4 h-0.5 w-20 bg-emerald-500"></div>
        <div class="mt-6 space-y-6">
          <div class="relative grid gap-4 sm:grid-cols-12">
            <div class="sm:col-span-3">
              <p class="font-mono text-sm font-medium text-emerald-500">2024</p>
            </div>
            <div class="relative sm:col-span-9">
              <div class="absolute -left-4 top-1.5 hidden h-2 w-2 rounded-full bg-emerald-500 sm:block"></div>
              <h3 class="text-lg font-semibold text-slate-50">Bachelor in Wirtschaftswissenschaften & Management</h3>
            </div>
          </div>
        </div>
      </section>

      <!-- BACHELORARBEIT -->
      <section data-cv-section class="mb-10 sm:mb-12">
        <h2 class="text-xl font-bold tracking-tight text-slate-50 sm:text-2xl">BACHELORARBEIT</h2>
        <div class="mt-4 h-0.5 w-20 bg-emerald-500"></div>
        <div class="mt-6 grid gap-4 sm:grid-cols-12">
          <div class="sm:col-span-3">
            <p class="font-mono text-sm font-medium text-emerald-500">2023</p>
          </div>
          <div class="relative sm:col-span-9">
            <div class="absolute -left-4 top-1.5 hidden h-2 w-2 rounded-full bg-emerald-500 sm:block"></div>
            <h3 class="text-lg font-semibold text-slate-50">„L'utilisation de ChatGPT dans les entreprises : Impacts et enjeux économiques“</h3>
            <p class="mt-3 leading-relaxed text-slate-300">
              Untersuchung der Einsatzmöglichkeiten, wirtschaftlichen Auswirkungen und Herausforderungen von ChatGPT in Unternehmen.
            </p>
          </div>
        </div>
      </section>

      <!-- BERUFSERFAHRUNG -->
      <section data-cv-section class="mb-10 sm:mb-12">
        <h2 class="text-xl font-bold tracking-tight text-slate-50 sm:text-2xl">BERUFSERFAHRUNG</h2>
        <div class="mt-4 h-0.5 w-20 bg-emerald-500"></div>
        <div class="mt-6 space-y-8">
          <div class="grid gap-4 sm:grid-cols-12">
            <div class="sm:col-span-3">
              <p class="font-mono text-sm font-medium text-emerald-500">03/2026 – heute</p>
            </div>
            <div class="relative sm:col-span-9">
              <div class="absolute -left-4 top-1.5 hidden h-2 w-2 rounded-full bg-emerald-500 sm:block"></div>
              <h3 class="text-lg font-semibold text-slate-50">Manager</h3>
              <p class="text-base text-slate-300">Café Classico (inkl. Fußballplatz)</p>
              <p class="mt-3 leading-relaxed text-slate-400">
                Teamführung, Organisation des Tagesgeschäfts, Kundenbetreuung und Optimierung von Abläufen.
              </p>
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-12">
            <div class="sm:col-span-3">
              <p class="font-mono text-sm font-medium text-emerald-500">11/2025 – 03/2026</p>
            </div>
            <div class="relative sm:col-span-9">
              <div class="absolute -left-4 top-1.5 hidden h-2 w-2 rounded-full bg-emerald-500 sm:block"></div>
              <h3 class="text-lg font-semibold text-slate-50">Freelancer</h3>
              <p class="text-base text-slate-300">Web- &amp; Bot-Entwicklung</p>
              <p class="mt-3 leading-relaxed text-slate-400">
                Freelance-Projekte in Web- und Bot-Entwicklung mit Python und SQLite.
              </p>
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-12">
            <div class="sm:col-span-3">
              <p class="font-mono text-sm font-medium text-emerald-500">07/2024 – 11/2025</p>
            </div>
            <div class="relative sm:col-span-9">
              <div class="absolute -left-4 top-1.5 hidden h-2 w-2 rounded-full bg-emerald-500 sm:block"></div>
              <h3 class="text-lg font-semibold text-slate-50">Manager (zuvor Service/Barista)</h3>
              <p class="text-base text-slate-300">Café Saraya</p>
              <p class="mt-3 leading-relaxed text-slate-400">
                Personalführung, Organisation des Tagesgeschäfts und Kundenbetreuung; zuvor im Service und als Barista.
              </p>
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-12">
            <div class="sm:col-span-3">
              <p class="font-mono text-sm font-medium text-emerald-500">01/2024 – 05/2024</p>
            </div>
            <div class="relative sm:col-span-9">
              <div class="absolute -left-4 top-1.5 hidden h-2 w-2 rounded-full bg-emerald-500 sm:block"></div>
              <h3 class="text-lg font-semibold text-slate-50">Praktikant (Management &amp; Digitalisierung)</h3>
              <p class="text-base text-slate-300">MEDINDUSTRY</p>
            </div>
          </div>
        </div>
      </section>

      <!-- WEITERBILDUNG -->
      <section data-cv-section class="mb-10 sm:mb-12">
        <h2 class="text-xl font-bold tracking-tight text-slate-50 sm:text-2xl">WEITERBILDUNG</h2>
        <div class="mt-4 h-0.5 w-20 bg-emerald-500"></div>
        <div class="mt-6 space-y-6">
          <div class="grid gap-4 sm:grid-cols-12">
            <div class="sm:col-span-3">
              <p class="font-mono text-sm font-medium text-emerald-500">telc-Vorbereitung</p>
            </div>
            <div class="relative sm:col-span-9">
              <div class="absolute -left-4 top-1.5 hidden h-2 w-2 rounded-full bg-emerald-500 sm:block"></div>
              <h3 class="text-base font-semibold text-slate-50">Deutsch B2</h3>
            </div>
          </div>
          <div class="grid gap-4 sm:grid-cols-12">
            <div class="sm:col-span-3">
              <p class="font-mono text-sm font-medium text-emerald-500">Weiterbildung</p>
            </div>
            <div class="relative sm:col-span-9">
              <div class="absolute -left-4 top-1.5 hidden h-2 w-2 rounded-full bg-emerald-500 sm:block"></div>
              <h3 class="text-base font-semibold text-slate-50">Python</h3>
            </div>
          </div>
          <div class="grid gap-4 sm:grid-cols-12">
            <div class="sm:col-span-3">
              <p class="font-mono text-sm font-medium text-emerald-500">Weiterbildung</p>
            </div>
            <div class="relative sm:col-span-9">
              <div class="absolute -left-4 top-1.5 hidden h-2 w-2 rounded-full bg-emerald-500 sm:block"></div>
              <h3 class="text-base font-semibold text-slate-50">KI-Tools</h3>
            </div>
          </div>
        </div>
      </section>

      <!-- PROJEKTE -->
      <section data-cv-section class="mb-10 sm:mb-12">
        <h2 class="text-xl font-bold tracking-tight text-slate-50 sm:text-2xl">PROJEKTE</h2>
        <div class="mt-4 h-0.5 w-20 bg-emerald-500"></div>
        <div class="mt-6 grid gap-4 sm:grid-cols-12">
          <div class="sm:col-span-3">
            <p class="font-mono text-sm font-medium text-emerald-500">Eigenes Projekt</p>
          </div>
          <div class="relative sm:col-span-9">
            <div class="absolute -left-4 top-1.5 hidden h-2 w-2 rounded-full bg-emerald-500 sm:block"></div>
            <h3 class="text-lg font-semibold text-slate-50">Ausbildung Smart Match Bot</h3>
            <p class="mt-1 font-mono text-xs text-slate-500">seit 10/2026 · Python + KI</p>
            <p class="mt-3 leading-relaxed text-slate-300">
              Automatisierte Auswertung von Ausbildungsangeboten, Profilsabgleich und Priorisierung passender Stellen mittels Web Scraping, 
              LLM-basierter Bewertung und Telegram-Benachrichtigungen. Vollständig automatisiert vom ersten Scan bis zur Benachrichtigung.
            </p>
          </div>
        </div>
      </section>

      <!-- KENNTNISSE -->
      <section data-cv-section class="mb-10 sm:mb-12">
        <h2 class="text-xl font-bold tracking-tight text-slate-50 sm:text-2xl">KENNTNISSE</h2>
        <div class="mt-4 h-0.5 w-20 bg-emerald-500"></div>
        <div class="mt-6 grid gap-8 sm:grid-cols-2">
          <div>
            <h3 class="font-mono text-xs uppercase tracking-wider text-emerald-500">Technische Kenntnisse</h3>
            <ul class="mt-4 space-y-2 text-slate-300">
              <li>Python, SQL, Web Scraping</li>
              <li>REST APIs, Telegram Bots</li>
              <li>AI/LLM, Automation</li>
              <li>Git, Docker, Linux</li>
              <li>ERP, Datenmanagement</li>
              <li>Freelance Web/Bot-Entwicklung (Python, SQLite)</li>
            </ul>
          </div>
          <div>
            <h3 class="font-mono text-xs uppercase tracking-wider text-emerald-500">Soziale & Organisatorische Kenntnisse</h3>
            <ul class="mt-4 space-y-2 text-slate-300">
              <li>Strukturiertes Arbeiten</li>
              <li>Kommunikation & Teamarbeit</li>
              <li>Lösungsorientierung</li>
              <li>Verantwortungsbewusstsein</li>
              <li>Organisation & Zeitmanagement</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- SPRACHEN -->
      <section data-cv-section class="mb-10 sm:mb-12">
        <h2 class="text-xl font-bold tracking-tight text-slate-50 sm:text-2xl">SPRACHEN</h2>
        <div class="mt-4 h-0.5 w-20 bg-emerald-500"></div>
        <div class="mt-6 space-y-4">
          <div class="flex flex-col justify-between gap-2 border-b border-slate-800/60 pb-3 sm:flex-row sm:items-center">
            <span class="text-slate-200">Deutsch</span>
            <span class="font-mono text-sm text-emerald-500">B2 · telc-Vorbereitung läuft</span>
          </div>
          <div class="flex flex-col justify-between gap-2 border-b border-slate-800/60 pb-3 sm:flex-row sm:items-center">
            <span class="text-slate-200">Englisch</span>
            <span class="font-mono text-sm text-slate-400">fließend</span>
          </div>
          <div class="flex flex-col justify-between gap-2 border-b border-slate-800/60 pb-3 sm:flex-row sm:items-center">
            <span class="text-slate-200">Arabisch</span>
            <span class="font-mono text-sm text-slate-400">Muttersprache</span>
          </div>
        </div>
      </section>

      <!-- PERSÖNLICHE STÄRKEN -->
      <section data-cv-section class="mb-10 sm:mb-12">
        <h2 class="text-xl font-bold tracking-tight text-slate-50 sm:text-2xl">PERSÖNLICHE STÄRKEN</h2>
        <div class="mt-4 h-0.5 w-20 bg-emerald-500"></div>
        <ul class="mt-6 grid gap-x-6 gap-y-3 sm:grid-cols-2">
          <li class="flex items-start gap-3 text-slate-300">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            Lernbereitschaft & Eigeninitiative
          </li>
          <li class="flex items-start gap-3 text-slate-300">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            Strukturiertes und analytisches Denken
          </li>
          <li class="flex items-start gap-3 text-slate-300">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            Praxisorientiert & lösungsorientiert
          </li>
          <li class="flex items-start gap-3 text-slate-300">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            Zuverlässig, diszipliniert und teamfähig
          </li>
        </ul>
      </section>

      <!-- INTERESSEN -->
      <section data-cv-section class="mb-10 sm:mb-12">
        <h2 class="text-xl font-bold tracking-tight text-slate-50 sm:text-2xl">INTERESSEN</h2>
        <div class="mt-4 h-0.5 w-20 bg-emerald-500"></div>
        <p class="mt-6 leading-relaxed text-slate-300">
          Digitalisierung, Künstliche Intelligenz, Automatisierung, Prozessoptimierung und kontinuierliches Lernen.
        </p>
      </section>

      <!-- FÜHRERSCHEIN -->
      <section data-cv-section class="mb-10 sm:mb-12">
        <h2 class="text-xl font-bold tracking-tight text-slate-50 sm:text-2xl">FÜHRERSCHEIN</h2>
        <div class="mt-4 h-0.5 w-20 bg-emerald-500"></div>
        <p class="mt-6 text-slate-300">Klasse B</p>
      </section>

      <!-- PDF Button Ende -->
      <div class="mt-12 flex justify-center border-t border-slate-800/60 pt-8">
        <a
          href="/cv/Youssef-Lafdi-CV.pdf"
          download
          class="group inline-flex items-center gap-2 rounded-lg bg-emerald-500 px-8 py-4 text-sm font-semibold text-slate-950 transition-colors duration-200 hover:bg-emerald-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950"
        >
          PDF herunterladen
          <span class="transition-transform duration-200 group-hover:translate-y-0.5" aria-hidden="true">↓</span>
        </a>
      </div>
    </article>
  </section>

  <Footer />
</BaseLayout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReduced) {
    const sections = gsap.utils.toArray<HTMLElement>('[data-cv-section]');
    gsap.fromTo(
      sections,
      { y: 20, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.6,
        stagger: 0.08,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: document.body,
          start: 'top 90%',
          once: true,
        },
      }
    );
  }
</script>